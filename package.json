{
    "name": "datatables.net-responsive-se",
    "description": "Responsive for DataTables with styling for [SemanticUI](https://semantic-ui.com/)",
    "main": "./js/responsive.semanticui.js",
    "module": "./js/responsive.semanticui.mjs",
    "style": "./css/responsive.semanticui.css",
    "types": "./types/responsive.semanticui.d.ts",
    "version": "4.1.0",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "Responsive",
        "Semantic",
        "SemanticUI",
        "Semantic UI",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-responsive": "4.1.0",
        "datatables.net-se": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/Responsive.git"
    },
    "exports": {
        ".": {
            "types": "./types/responsive.semanticui.d.ts",
            "style": "./css/responsive.semanticui.css",
            "import": "./js/responsive.semanticui.mjs",
            "require": "./js/responsive.semanticui.js",
            "default": "./js/responsive.semanticui.mjs"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/responsive.semanticui.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}